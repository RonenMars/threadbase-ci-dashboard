# GitHub OAuth App — user login only (create at github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth.js session signing secret (run: openssl rand -base64 32)
AUTH_SECRET=

# GitHub App — repo/Actions API (create at github.com/settings/apps)
# Permissions: Actions read/write, Contents read, Metadata read.
# Install on TB_MOBILE_REPO + TB_STREAMER_REPO; paste installation id from the
# install URL (.../installations/<id>). Private key: PEM; on Vercel use \n newlines.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Neon connection string (from Vercel Neon integration or neon.tech)
DATABASE_URL=

# Upstash Redis (from Vercel Upstash integration or upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub webhook HMAC secret (random string, set same value in GitHub repo settings)
WEBHOOK_SECRET=

# Deployable projects (repo + workflow per project)
TB_MOBILE_REPO=RonenMars/threadbase-mobile
TB_MOBILE_WORKFLOW_ID=deploy.yml
TB_STREAMER_REPO=RonenMars/threadbase-streamer
TB_STREAMER_WORKFLOW_ID=release.yml
